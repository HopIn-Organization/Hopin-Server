PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=hopin_db
DB_SYNCHRONIZE=true
DB_LOGGING=false
JWT_ACCESS_SECRET=hopin_access_secret_dev
JWT_REFRESH_SECRET=hopin_refresh_secret_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=7
LANGFUSE_HOST=https://api.langfuse.com
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_ENABLED=true
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
S3_BUCKET_NAME=hopin-project-documents
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
GEMINI_API_KEY=your_gemini_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=your_index_name

# GitHub App Integration (see github-integration-plan-accurate.md for setup steps)
# Register a GitHub App at github.com → Settings → Developer settings → GitHub Apps
GITHUB_APP_ID=4168352               # numeric App ID shown at top of App settings page
GITHUB_APP_SLUG=hopin-repos            # URL-friendly name (e.g. hop-on-repo-sync) — used in the install URL
GITHUB_APP_PRIVATE_KEY=      # full .pem contents — escape newlines as \n if using a .env file
GITHUB_WEBHOOK_SECRET=       # random string used to verify webhook payloads (openssl rand -hex 32)
# REQUIRED in GitHub App settings: go to github.com → Settings → Developer settings → GitHub Apps → <your app> →
# "Setup URL (optional)" and set it to this exact URL. GitHub will also honour the redirect_uri we pass in the
# install link, but the two must match — GitHub rejects redirect_uri values that differ from the registered Setup URL.
# Production example:  https://api.yourdomain.com/github/callback
# Local dev example:   http://localhost:3000/github/callback
GITHUB_APP_CALLBACK_URL=http://localhost:3000/github/callback

# Optional. Repo sync shells out to the `git` binary, which must exist in the same
# environment as the server process — in production that is the Docker image, not
# the host (the Dockerfile installs it). Leave unset to resolve `git` from PATH;
# set only if git lives somewhere non-standard.
# GIT_BINARY_PATH=/usr/bin/git

# Local development only — smee.io webhook proxy (see github-integration-plan-accurate.md § Local dev)
# Get a free channel at https://smee.io → "Start a new channel" → copy the URL here
# Run `npm run dev:webhook` in a separate terminal to forward GitHub webhooks to localhost
SMEE_CHANNEL_URL=https://smee.io/UkMiIKn64DglGgs

# Frontend origin — used to redirect the user back after GitHub App install callback
# Local dev: http://localhost:5173  |  Production: https://yourdomain.com
CLIENT_ORIGIN=http://localhost:5173
